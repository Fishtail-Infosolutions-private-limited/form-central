# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://fcadmin:StrongSecretPassword123!@localhost:5432/form_central?schema=public"

# App Configuration
NEXT_PUBLIC_APP_URL="https://your-domain.com"
APP_NAME="Form Central"
PORT=3000
NODE_ENV="production"

# Authentication (32+ character random secret)
# Generate via: openssl rand -base64 32
AUTH_SECRET="fc_production_grade_secret_running_comp_2026_super_key_32chars"

# Email Delivery (Gmail SMTP for OTP Verification & Participant Notices)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="neosparknepal@gmail.com"
SMTP_PASSWORD="your-google-app-password"
EMAIL_FROM="neosparknepal@gmail.com"
EMAIL_FROM_NAME="Form Central"

# Google Drive OAuth 2.0 Integration (for Participant Video Uploads)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://your-domain.com/api/google-drive/callback"

# File Upload Constraints
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_DOCUMENT_SIZE_MB=25
